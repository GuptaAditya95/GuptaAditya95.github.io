---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { KINDS } from '../../consts';
import { getPosts, slugify } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, kind, tags, draft } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={description} type="article">
  <article>
    <header>
      <span class="kind">{KINDS[kind].label}{draft && ' · draft'}</span>
      <h1>{title}</h1>
      <p class="small muted">
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        {updated && <> · updated {fmt(updated)}</>}
      </p>
    </header>
    <div class="prose"><Content /></div>
    {tags.length > 0 && <div class="tags foot">{tags.map((t) => <a class="tag" href={`/tags/${slugify(t)}/`}>{t}</a>)}</div>}
  </article>
  <p class="small"><a href="/blog/">← All posts</a></p>
</Base>
<style>
  header { margin: 1rem 0 2rem; }
  header p { margin: 0; }
  .foot { margin-top: 2.5rem; }
</style>
