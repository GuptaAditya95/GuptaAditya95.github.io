---
import { SITE } from '../consts';
const { github, linkedin, x } = SITE.links;
---
<footer class="wrap small muted">
  <div class="links">
    {github && <a href={github}>GitHub</a>}
    {linkedin && <a href={linkedin}>LinkedIn</a>}
    {x && <a href={x}>X</a>}
    {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
    <a href="/community/">Join the community</a>
    <a href="/rss.xml">RSS</a>
  </div>
  <p class="sign">© {new Date().getFullYear()} {SITE.name} · learning in public</p>
</footer>
<style>
  footer { margin-top: 5rem; padding-top: 1.5rem; padding-bottom: 3rem; border-top: 1.5px dashed var(--border); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .links a { color: var(--muted); }
  p { margin: 0; }
  .sign { font-family: var(--hand); font-size: 1.35rem; line-height: 1; color: var(--text); }
</style>
